{
  "name": "@klear/root",
  "version": "0.1.0",
  "description": "Klear monorepo root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx packages/cli/src/index.ts",
    "dev:api": "tsx packages/server/src/index.ts",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^9.8.0",
    "prettier": "^3.3.0",
    "tsx": "^4.20.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@12.0.1",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
