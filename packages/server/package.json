{
  "name": "@klear/server",
  "version": "0.1.0",
  "description": "Klear REST API server — vectorize images via HTTP",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@klear/core": "file:../core",
    "express": "^5.2.1",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
